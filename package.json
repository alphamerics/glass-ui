{
  "name": "glass-ui",
  "version": "0.1.0",
  "description": "Reusable liquid glass web UI kit: React components that drive native GPU glass surfaces behind the DOM, the Tauri invoke bridge they need, and the shared glass design system (SF Pro Display, menu/modal/glass styles).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css"
  },
  "files": [
    "src",
    "styles.css",
    "fonts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": ">=0.400.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tauri-apps/api": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "lucide-react": "^1.51.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.3"
  }
}
